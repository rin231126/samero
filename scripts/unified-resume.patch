+/* Bind an observed test to the archived workspace and configured command.
+   External dependencies and environment are not fully fingerprinted; VERIFY
+   must still inspect actual evidence and may require a fresh test. */
+static int test_signature(const Run *r,char out[65]) {
+    char executable[65]; Error ignored={0}; out[0]=0;
+    if (strlen(r->source_hash)!=64 || !digest_file(r->checks[0].exe.p,executable,&ignored)) return 0;
+    Sha256 sha={0};
+    sha_update(&sha,r->source_hash,65);
+    sha_update(&sha,r->checks[0].exe.p,strlen(r->checks[0].exe.p)+1);
+    sha_update(&sha,r->checks[0].args,strlen(r->checks[0].args)+1);
+    sha_update(&sha,executable,65); sha_finish(&sha,out); return 1;
+}
