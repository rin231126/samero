+    def test_windows_preflight_uses_default_output_cap(self):
+        cmd=self.runner_fixture()
+        home=self.root/"Autonomous"
+        (home/"windows-readiness").write_text("ready")
+        (home/"verify-case").write_text("no-tools")
+        rid=self.req("runner-start",cmd)["id"]
+        r=self.run_state(rid,lambda r:r["mode"]=="review" and not r["snapshot"])
+        self.assertEqual((r["index"],r["blocker"]),(0,"BLOCKED_VERIFY"),r["reason"])
+        task=r["tasks"][0]
+        self.assertIn("preflight=READ_OK;",task["verifyObservation"])
+        self.assertFalse(task["verifySession"])
+        packets=[json.loads(line) for line in (home/"rpc.jsonl").read_text().splitlines()]
+        checks=[p["params"] for p in packets if p["method"]=="command/exec"]
+        self.assertEqual(len(checks),1)
+        self.assertNotIn("outputBytesCap",checks[0])
+        self.assertNotIn("disableOutputCap",checks[0])
+        self.assertEqual(checks[0]["sandboxPolicy"],{"type":"readOnly","networkAccess":False})
+        self.assertTrue(any(p["method"]=="turn/start" and p["params"]["input"][0]["text"].startswith("SAMERO VERIFY.") for p in packets))
+
